<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · OrderFlow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav wrap" aria-label="Main navigation">
            <a class="brand" asp-controller="Home" asp-action="Index">OrderFlow</a>
            <div class="nav-links">
                <a href="/products">Products</a>
                <a href="/customers">Customers</a>
                <a href="/orders">Orders</a>
                <a href="/reports">Reports</a>
            </div>
        </nav>
    </header>
    <main class="wrap">
        @if (TempData["Message"] is string message)
        {
            <div class="alert success" role="status">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="wrap footer">OrderFlow · Inventory and order management demo</footer>
</body>
</html>
