@model CustomerForm
@{
    ViewData["Title"] = "Add customer";
}
<div class="page-heading"><div><p class="eyebrow">People</p><h1>Add customer</h1></div><a href="/customers">← Customers</a></div>
<section class="panel form-panel">
    <form method="post" action="/customers/new">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <div class="field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation"></span></div>
        <div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" /><span asp-validation-for="Email" class="validation"></span></div>
        <button class="button primary" type="submit">Save customer</button>
    </form>
</section>
