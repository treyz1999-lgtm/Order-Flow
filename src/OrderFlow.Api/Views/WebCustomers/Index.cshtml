@model List<CustomerResponse>
@{
    ViewData["Title"] = "Customers";
}
<div class="page-heading"><div><p class="eyebrow">People</p><h1>Customers</h1><p>Create a customer before placing an order.</p></div><a class="button primary" href="/customers/new">Add customer</a></div>
<section class="panel">
    @if (Model.Count == 0)
    {
        <p class="muted">No customers yet.</p>
    }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>ID</th></tr></thead><tbody>
        @foreach (var customer in Model)
        {
            <tr><td><strong>@customer.Name</strong></td><td>@customer.Email</td><td>#@customer.Id</td></tr>
        }
        </tbody></table></div>
    }
</section>
