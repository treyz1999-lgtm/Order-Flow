@model List<OrderResponse>
@{
    ViewData["Title"] = "Orders";
}
<div class="page-heading"><div><p class="eyebrow">Fulfillment</p><h1>Orders</h1><p>Review orders and update their status.</p></div><a class="button primary" href="/orders/new">Place order</a></div>
<section class="panel">
    @if (Model.Count == 0)
    {
        <p class="muted">No orders yet. Place the first one to see it here.</p>
    }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer ID</th><th>Date</th><th>Status</th><th>Total</th></tr></thead><tbody>
        @foreach (var order in Model)
        {
            <tr><td><a href="/orders/@order.Id"><strong>#@order.Id</strong></a></td><td>#@order.CustomerId</td><td>@order.CreatedAtUtc.ToLocalTime().ToString("g")</td><td><span class="badge">@order.Status</span></td><td>@order.Total.ToString("C")</td></tr>
        }
        </tbody></table></div>
    }
</section>
