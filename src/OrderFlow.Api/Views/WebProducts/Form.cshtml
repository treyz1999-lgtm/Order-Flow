@model ProductForm
@{
    ViewData["Title"] = Model.Id == 0 ? "Add product" : "Edit product";
    var actionUrl = Model.Id == 0 ? "/products/new" : $"/products/{Model.Id}/edit";
}
<div class="page-heading"><div><p class="eyebrow">Inventory</p><h1>@ViewData["Title"]</h1></div><a href="/products">← Products</a></div>
<section class="panel form-panel">
    <form method="post" action="@actionUrl">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <div class="field"><label asp-for="Name"></label><input asp-for="Name" autocomplete="off" /><span asp-validation-for="Name" class="validation"></span></div>
        <div class="field"><label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" min="0.01" /><span asp-validation-for="Price" class="validation"></span></div>
        <div class="field"><label asp-for="StockQuantity">Stock quantity</label><input asp-for="StockQuantity" type="number" min="0" /><span asp-validation-for="StockQuantity" class="validation"></span></div>
        <button class="button primary" type="submit">Save product</button>
    </form>
</section>
