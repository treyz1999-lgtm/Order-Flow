@model List<ProductResponse>
@{
    ViewData["Title"] = "Products";
}
<div class="page-heading"><div><p class="eyebrow">Inventory</p><h1>Products</h1><p>Keep prices and stock quantities up to date.</p></div><a class="button primary" href="/products/new">Add product</a></div>
<section class="panel">
    @if (Model.Count == 0)
    {
        <p class="muted">No products yet. Add your first product to get started.</p>
    }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th class="align-right">Actions</th></tr></thead><tbody>
        @foreach (var product in Model)
        {
            <tr><td><strong>@product.Name</strong><span class="subtle">#@product.Id</span></td><td>@product.Price.ToString("C")</td><td>@product.StockQuantity</td><td class="align-right row-actions">
                <a href="/products/@product.Id/edit">Edit</a>
                <form method="post" action="/products/@product.Id/delete" onsubmit="return confirm('Delete this product?');">
                    @Html.AntiForgeryToken()
                    <button class="text-danger" type="submit">Delete</button>
                </form>
            </td></tr>
        }
        </tbody></table></div>
    }
</section>
